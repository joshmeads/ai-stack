      "label": "Body text size"
    },
    "--body-leading": {
      "kind": "size",
      "role": "Typography › Body line height, 28",
      "label": "Body line height"
    },
    "--ui-size": {
      "kind": "size",
      "role": "Typography › UI (menu, pill, buttons), 15",
      "label": "Button text size"
    },
    "--ui-tracking": {
      "kind": "em",
      "role": "Typography › UI tracking, −0.01em",
      "label": "Button text spacing"
    },
    "--logo-size": {
