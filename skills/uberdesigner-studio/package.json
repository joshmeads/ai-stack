{
  "name": "uberdesigner-studio",
  "private": true,
  "license": "AGPL-3.0-only",
  "type": "module",
  "description": "Build tooling for the uberdesigner studio skill: bundles its panel for sites with no build step. Skill users don't need to run this; runtime/panel/ is the result.",
  "scripts": {
    "build:panel": "vite build --config panel.vite.config.ts",
    "typecheck": "tsc --noEmit -p runtime/panel-src/tsconfig.json && tsc --noEmit -p tsconfig.server.json",
    "test": "node --test tests/unit/*.test.mjs"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "~5.9.3",
    "vite": "^8.3.5"
  }
}
