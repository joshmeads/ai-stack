# Session-local Claude Code state — not part of the plugin
.remember/
.claude/worktrees/
.claude/.cc-writes/

# OS / editor
.DS_Store
*.swp
*.swo

# VS Code per-user
.vscode/

# Python bytecode
__pycache__/

# bun deps for the vendored poteto-mode scripts (bootstrap.ts installs them on first run)
plugins/pstack/skills/poteto-mode/scripts/node_modules/

# ai-stack skills staging
.ai-stack/

# Private skills and manifest; committed only as the encrypted private.age (ai-stack private)
/private/
/.private.new.*/
/.private.old.*/

# Skills downloaded from their upstream by `ai-stack skills update`, never committed
/skills/reverse-engineer-anything/

# cdt run artifacts (skills/devtools-perf)
.cdt-runs/
